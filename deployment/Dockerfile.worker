# SkySolver v2 - Solver Worker Container
# Elastic, horizontally-scalable worker for tiered solving

FROM python:3.11-slim

# System deps for pyomo/MILP solvers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The base image ships older pip tooling that carries two fixable HIGH CVEs
# (CVE-2026-24049 in wheel, CVE-2026-23949 in the jaraco.context bundled with
# setuptools). Upgrade before installing anything else so the image does not
# inherit them.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY . .

RUN groupadd --gid 10001 skysolver && useradd --uid 10001 --gid skysolver --no-create-home skysolver \
    && chown -R 10001:10001 /app

USER 10001:10001

# Worker entry point - consumes from queue, solves partitions, publishes results
CMD ["python", "-m", "deployment.worker"]
