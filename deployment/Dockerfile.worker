# SkySolver v2 - Solver Worker Container
# Elastic, horizontally-scalable worker for tiered solving

FROM python:3.11-slim

# System deps for pyomo/MILP solvers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY . .

# Worker entry point - consumes from queue, solves partitions, publishes results
CMD ["python", "-m", "deployment.worker"]
