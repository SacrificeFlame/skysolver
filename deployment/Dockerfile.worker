# SkySolver v2 - Solver Worker Container
# Elastic, horizontally-scalable worker for tiered solving

FROM python:3.11-slim

# System deps for pyomo/MILP solvers
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Current build tooling, so wheels build against maintained setuptools rather
# than whatever the base image froze. Removed again further down; nothing here
# survives into the runtime image.
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Install Python deps
COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt

# Drop the installer from the runtime image. A worker never installs anything at
# run time, and pip carries its dependencies vendored inside pip/_vendor —
# currently msgpack 1.1.2 and setuptools 70.3.0, both with HIGH advisories.
# Those copies cannot be upgraded: the newest pip still ships exactly those
# versions, so `pip install --upgrade pip` moves the real setuptools and leaves
# the vendored one untouched. Removing the installer removes them outright and
# leaves less in the image than we started with.
RUN python -m pip uninstall --yes pip setuptools wheel \
    && rm -rf /usr/local/lib/python3.11/ensurepip

# Copy source
COPY . .

RUN groupadd --gid 10001 skysolver && useradd --uid 10001 --gid skysolver --no-create-home skysolver \
    && chown -R 10001:10001 /app

USER 10001:10001

# Worker entry point - consumes from queue, solves partitions, publishes results
CMD ["python", "-m", "deployment.worker"]
